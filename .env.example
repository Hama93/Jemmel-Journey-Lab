FLASK_SECRET_KEY=replace-with-a-secure-secret
FLASK_ENV=development

# Comma-separated admin emails that can access /admin/attractions
ADMIN_EMAILS=admin@example.com

# Option 1: full service account JSON string for Render env var
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project-id"}

# Option 2: base64-encoded service account JSON (safer to paste in some dashboards)
# FIREBASE_SERVICE_ACCOUNT_B64=eyJ0eXBlIjoic2VydmljZV9hY2NvdW50Iiwi...

# Option 3: local path for service account JSON (for local dev)
# FIREBASE_CREDENTIALS_PATH=something.json
# Option 4: standard Google credentials env var
# GOOGLE_APPLICATION_CREDENTIALS=app/tunisia-tourism-firebase-adminsdk-seadi-18c763db2c.json
